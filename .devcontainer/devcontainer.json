{
  "name": "Lumen",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Lumen preview",
      "onAutoForward": "openPreview"
    }
  },
  "postAttachCommand": "python3 -m http.server 8000",
  "customizations": {
    "vscode": {
      "extensions": ["editorconfig.editorconfig"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
